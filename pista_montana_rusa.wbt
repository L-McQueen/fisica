      translation 0.8197 1.2040 0.0450
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.85 0.12 0.12
            roughness 0.5
          }
          geometry Box { size 0.11 0.020 0.050 }
        }
      ]
    }
  ]
  name "pista_circuito"
  contactMaterial "TrackMaterial"
  boundingObject Group {
    children [
      USE GEO_CIRCUITO
      Transform {
        translation 0.4550 0.2000 0.9350
        children [ Box { size 0.010 0.11 0.040 } ]
      }
      Transform {
        translation 0.8197 1.2040 0.0450
        children [ Box { size 0.11 0.020 0.050 } ]
      }
    ]
  }
}


